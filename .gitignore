# -----------------------------------------------------------------------------
# hütten — NTNUI Koiene availability CLI
# -----------------------------------------------------------------------------

# --- Python bytecode / build artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so

build/
dist/
sdist/
wheels/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Virtual environments (uv-managed .venv, plain venv, conda) ---
.venv/
venv/
env/
ENV/
.conda/

# uv (keep uv.lock tracked for reproducible builds; ignore its cache)
.uv/
# NOTE: requirements.txt and uv.lock should be committed — do not ignore them.

# --- Test / coverage / type-checker / linter caches ---
.pytest_cache/
.nox/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.dmypy.json
.ruff_cache/
.pyre/
.hypothesis/

# --- Packaging / tooling ---
*.log
.pybuild/

# --- Environment variables & secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Output / scraped data (regenerate by running the CLI) ---
# The CLI prints JSON to stdout; redirects and scratch exports are not source.
*.out.json
out/
output/
*.tmp

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# --- Jupyter (if notebooks are added later) ---
.ipynb_checkpoints/
